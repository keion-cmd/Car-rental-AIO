generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==================== ENUMS ====================

enum VehicleTransmission {
  MANUAL
  AUTOMATIC
}

enum VehicleFuelType {
  PETROL
  DIESEL
  HYBRID
  ELECTRIC
}

enum BookingStatus {
  PENDING
  CONFIRMED
  ONGOING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  REFUNDED
  FAILED
}

enum BlockType {
  BOOKING
  HOLD
  MAINTENANCE
  MANUAL
  TRANSFER
}

enum BookingSource {
  WEBSITE
  PHONE
  WALK_IN
  PARTNER
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum MaintenanceType {
  SCHEDULED
  REPAIR
  INSPECTION
  CLEANING
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// OWNER added for P4-P1 (staff authentication): the role hierarchy this
// phase's guard enforces (lib/auth/guard.ts) needs a top tier above ADMIN
// for the bootstrap account created by scripts/create-admin.ts. ADMIN/
// MANAGER/STAFF are unchanged from their pre-existing meaning.
enum UserRole {
  OWNER
  ADMIN
  MANAGER
  STAFF
}

enum LineItemType {
  BASE_RATE
  SURCHARGE
  FEE
  TAX
  DISCOUNT
  ADDON
  PROTECTION
  EXTRA_CHARGE
}

enum NotificationType {
  BOOKING_RECEIVED
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  PICKUP_REMINDER
  RETURN_REMINDER
  PAYMENT_RECEIVED
  ADMIN_NEW_BOOKING
}

enum NotificationChannel {
  EMAIL
  SMS
  IN_APP
}

enum NotificationStatus {
  QUEUED
  SENDING
  SENT
  FAILED
  CANCELLED
}

// ==================== TABLES ====================

model Settings {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  currency               String   @default("PHP")
  businessTimezone       String   @default("Asia/Manila") @map("business_timezone")
  // Operational time consumed by availability between two bookings on the
  // same vehicle (cleaning, inspection, repositioning). Distinct from
  // billingGraceMinutes below — do not conflate the two.
  defaultTurnaroundMinutes Int    @default(90) @map("default_turnaround_minutes")
  taxRateBps                 Int    @default(1200) @map("tax_rate_bps")
  youngDriverMaxAge           Int    @default(24) @map("young_driver_max_age")
  youngDriverSurchargePerDay  BigInt @default(0) @map("young_driver_surcharge_per_day")
  // How long past a 24-hour rental-day boundary a return may occur before
  // another full day is billed. Distinct from defaultTurnaroundMinutes
  // above, which is operational time consumed by availability — conflating
  // the two would corrupt availability. Inherits Settings.currency.
  billingGraceMinutes         Int    @default(59) @map("billing_grace_minutes")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("settings")
}

model User {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email       String   @unique
  role        UserRole @default(STAFF)
  name        String
  isActive    Boolean  @default(true) @map("is_active")
  locationIds String[] @default([]) @map("location_ids") @db.Uuid
  // scrypt-encoded (salt + hash, see lib/auth/password.ts). No @default —
  // a user without a password is an account anyone can claim.
  passwordHash        String    @map("password_hash")
  lastLoginAt          DateTime? @map("last_login_at") @db.Timestamptz
  failedLoginAttempts  Int       @default(0) @map("failed_login_attempts")
  lockedUntil          DateTime? @map("locked_until") @db.Timestamptz
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  sessions Session[]
  checkedOutBookings Booking[] @relation("BookingCheckedOutBy")
  checkedInBookings  Booking[] @relation("BookingCheckedInBy")

  @@map("users")
}

model Session {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  // SHA-256 of the raw session token — never the token itself (see
  // lib/auth/session.ts). A leaked database dump must not hand over live
  // sessions.
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastSeenAt   DateTime  @map("last_seen_at") @db.Timestamptz
  ipAddress    String?   @map("ip_address")
  userAgent    String?   @map("user_agent")
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Location {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  timezone          String
  openingHours      Json     @map("opening_hours")
  turnaroundMinutes Int      @default(90) @map("turnaround_minutes")
  prepMinutes       Int      @default(30) @map("prep_minutes")
  isAirport         Boolean  @default(false) @map("is_airport")
  supportsPickup    Boolean  @default(true) @map("supports_pickup")
  supportsDropoff   Boolean  @default(true) @map("supports_dropoff")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  vehiclesHome          Vehicle[]      @relation("HomeLocation")
  vehiclesCurrent       Vehicle[]      @relation("CurrentLocation")
  locationPairsFrom     LocationPair[] @relation("FromLocation")
  locationPairsTo       LocationPair[] @relation("ToLocation")
  vehicleBlocksEndingAt VehicleBlock[] @relation("EndsAtLocation")

  @@map("locations")
}

model LocationPair {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fromLocationId    String   @map("from_location_id") @db.Uuid
  toLocationId      String   @map("to_location_id") @db.Uuid
  isAllowed         Boolean  @default(true) @map("is_allowed")
  feeAmount         BigInt   @default(0) @map("fee_amount")
  minTransferHours  Int      @default(0) @map("min_transfer_hours")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  fromLocation Location @relation("FromLocation", fields: [fromLocationId], references: [id])
  toLocation   Location @relation("ToLocation", fields: [toLocationId], references: [id])

  @@unique([fromLocationId, toLocationId])
  @@map("location_pairs")
}

model VehicleCategory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  models VehicleModel[]

  @@map("vehicle_categories")
}

model VehicleModel {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId    String              @map("category_id") @db.Uuid
  make          String
  model         String
  seats         Int
  transmission  VehicleTransmission
  fuelType      VehicleFuelType     @map("fuel_type")
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  category VehicleCategory @relation(fields: [categoryId], references: [id])
  vehicles Vehicle[]

  @@map("vehicle_models")
}

model Vehicle {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  modelId            String   @map("model_id") @db.Uuid
  plateNumber        String   @unique @map("plate_number")
  // The label staff say out loud — "V-014" — distinct from the plate.
  // Nullable: existing vehicles have no value and inventing one is worse
  // than leaving it empty. Unique because two cars sharing one is a radio
  // conversation that ends with the wrong car.
  fleetNumber        String?  @unique @map("fleet_number")
  year               Int?
  homeLocationId     String   @map("home_location_id") @db.Uuid
  currentLocationId  String   @map("current_location_id") @db.Uuid
  isBookableOnline   Boolean  @default(true) @map("is_bookable_online")
  archivedAt         DateTime? @map("archived_at") @db.Timestamptz
  // Rates live on the vehicle, not the model: the product sells a specific
  // car, and two identical units at different branches may price
  // differently. Money columns inherit Settings.currency — this is a
  // single-currency system and a per-vehicle sibling would be redundant.
  // Defaulted to 0 (not literal-spec-required-only) so existing non-pricing
  // code paths (e.g. availability tests) that create a Vehicle without
  // pricing data keep working ahead of the pricing engine phase.
  dailyRate          BigInt   @default(0) @map("daily_rate")
  // weeklyRate/monthlyRate are PER-PERIOD totals (a whole week, a whole
  // month), not a per-day rate multiplied out. The pricing engine is
  // responsible for the conversion — do not read these as daily rates.
  weeklyRate         BigInt?  @map("weekly_rate")
  monthlyRate        BigInt?  @map("monthly_rate")
  securityDeposit    BigInt   @default(0) @map("security_deposit")
  includedKmPerDay   Int?     @map("included_km_per_day")
  extraKmRate        BigInt?  @map("extra_km_rate")
  minRentalDays      Int      @default(1) @map("min_rental_days")
  maxRentalDays      Int?     @map("max_rental_days")
  minDriverAge       Int      @default(21) @map("min_driver_age")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz

  model           VehicleModel        @relation(fields: [modelId], references: [id])
  homeLocation    Location            @relation("HomeLocation", fields: [homeLocationId], references: [id])
  currentLocation Location            @relation("CurrentLocation", fields: [currentLocationId], references: [id])
  images          VehicleImage[]
  blocks          VehicleBlock[]
  maintenance     MaintenanceRecord[]
  bookings        Booking[]
  quotes          Quote[]

  @@map("vehicles")
}

model VehicleImage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vehicleId String   @map("vehicle_id") @db.Uuid
  url       String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@map("vehicle_images")
}

model Customer {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email       String    @unique
  name        String
  phone       String?
  dateOfBirth DateTime? @map("date_of_birth") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  quotes   Quote[]
  bookings Booking[]

  @@map("customers")
}

model Quote {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Nullable: a quote is a hold on a vehicle, created when the customer
  // clicks Select — necessarily before any identity is collected. Identity
  // arrives later via attachCustomerToQuote(), or never (an abandoned quote
  // is the normal case, not an error). Booking.customerId stays required —
  // a booking always has a customer.
  customerId         String?     @map("customer_id") @db.Uuid
  vehicleId          String      @map("vehicle_id") @db.Uuid
  pickupLocationId   String      @map("pickup_location_id") @db.Uuid
  dropoffLocationId  String      @map("dropoff_location_id") @db.Uuid
  pickupAt           DateTime    @map("pickup_at") @db.Timestamptz
  returnAt           DateTime    @map("return_at") @db.Timestamptz
  // subtotalAmount/taxAmount/securityDeposit inherit currency from the
  // currency column below — a sibling per field would be redundant.
  subtotalAmount     BigInt      @default(0) @map("subtotal_amount")
  taxAmount          BigInt      @default(0) @map("tax_amount")
  securityDeposit    BigInt      @default(0) @map("security_deposit")
  rentalDays         Int         @default(1) @map("rental_days")
  totalAmount        BigInt      @map("total_amount")
  currency           String      @default("PHP")
  status             QuoteStatus @default(DRAFT)
  // Explicit, queryable hold expiry — replaces the prior in-memory 30-minute
  // TTL derived from createdAt. Required: a quote without an expiry cannot
  // back a HOLD block.
  expiresAt          DateTime    @map("expires_at") @db.Timestamptz
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  customer   Customer?       @relation(fields: [customerId], references: [id])
  vehicle    Vehicle         @relation(fields: [vehicleId], references: [id])
  lineItems  QuoteLineItem[]
  holdBlocks VehicleBlock[]

  @@map("quotes")
}

model QuoteLineItem {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quoteId     String       @map("quote_id") @db.Uuid
  type        LineItemType
  description String
  quantity    Int          @default(1)
  // unitAmount/totalAmount inherit currency from the parent Quote.currency
  // — a sibling here would be redundant.
  unitAmount  BigInt       @map("unit_amount")
  totalAmount BigInt       @map("total_amount")
  isTaxable   Boolean      @default(true) @map("is_taxable")
  sortOrder   Int          @default(0) @map("sort_order")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@map("quote_line_items")
}

model Booking {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // No @default: a booking created without a reference is the same class of
  // bug as a money column silently defaulting to 0. Callers must supply it.
  reference          String        @unique
  customerId         String        @map("customer_id") @db.Uuid
  vehicleId          String        @map("vehicle_id") @db.Uuid
  pickupLocationId   String        @map("pickup_location_id") @db.Uuid
  dropoffLocationId  String        @map("dropoff_location_id") @db.Uuid
  pickupAt           DateTime      @map("pickup_at") @db.Timestamptz
  returnAt           DateTime      @map("return_at") @db.Timestamptz
  // subtotalAmount/taxAmount/securityDeposit inherit currency from the
  // currency column below — a sibling per field would be redundant.
  subtotalAmount     BigInt        @default(0) @map("subtotal_amount")
  taxAmount          BigInt        @default(0) @map("tax_amount")
  securityDeposit    BigInt        @default(0) @map("security_deposit")
  rentalDays         Int           @default(1) @map("rental_days")
  totalAmount        BigInt        @map("total_amount")
  currency           String        @default("PHP")
  status             BookingStatus @default(PENDING)
  paymentStatus      PaymentStatus @default(UNPAID) @map("payment_status")
  source             BookingSource @default(WEBSITE)
  cancellationReason String?       @map("cancellation_reason")
  cancelledAt        DateTime?     @map("cancelled_at") @db.Timestamptz
  // The driver of record, snapshotted at booking time. Distinct from
  // Customer.* because the person who books is not always the person who
  // drives, and because a licence on file must reflect what was true on the
  // day of this booking even if the customer's own record changes later.
  // driverLicenceNumber is identity-document data — encrypted at rest via
  // lib/crypto/field-encryption.ts, never selected into a public-facing
  // response (see getBookingByReference).
  driverLicenceNumber  String        @map("driver_licence_number")
  driverLicenceCountry String        @map("driver_licence_country")
  driverLicenceExpiry  DateTime      @map("driver_licence_expiry") @db.Timestamptz
  driverFullName       String        @map("driver_full_name")
  driverPhone          String        @map("driver_phone")
  driverEmail          String        @map("driver_email")
  // Counter check-out/check-in (P5-P2). fuelOut/fuelIn are eighths of a
  // tank (0-8), not a percentage or float — matches what a fuel gauge
  // actually shows and avoids rounding disputes when charging for a
  // refuel. There is deliberately no Vehicle.odometer column: the
  // vehicle's "current" reading is derived from its own most recent
  // checked-out/checked-in booking (see getVehicleCurrentOdometer in
  // booking.service.ts) rather than a denormalized duplicate.
  odometerOut          Int?          @map("odometer_out")
  odometerIn           Int?          @map("odometer_in")
  fuelOut              Int?          @map("fuel_out")
  fuelIn               Int?          @map("fuel_in")
  checkedOutAt         DateTime?     @map("checked_out_at") @db.Timestamptz
  checkedInAt          DateTime?     @map("checked_in_at") @db.Timestamptz
  checkedOutById       String?       @map("checked_out_by_id") @db.Uuid
  checkedInById        String?       @map("checked_in_by_id") @db.Uuid
  // Internal only — must NEVER be exposed on any public route or in any
  // notification payload.
  staffNotes           String?       @map("staff_notes")
  // Minor units, like every other money column. Defaults to 0 — correct
  // for every existing booking (all UNPAID). Nothing writes this yet
  // (P8 owns that); it makes balanceDue computable instead of null.
  amountPaid           BigInt        @default(0) @map("amount_paid")
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  customer      Customer          @relation(fields: [customerId], references: [id])
  vehicle       Vehicle           @relation(fields: [vehicleId], references: [id])
  checkedOutBy  User?             @relation("BookingCheckedOutBy", fields: [checkedOutById], references: [id])
  checkedInBy   User?             @relation("BookingCheckedInBy", fields: [checkedInById], references: [id])
  lineItems     BookingLineItem[]
  blocks        VehicleBlock[]
  notifications Notification[]

  @@map("bookings")
}

model BookingLineItem {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId   String       @map("booking_id") @db.Uuid
  type        LineItemType
  description String
  quantity    Int          @default(1)
  // unitAmount/totalAmount inherit currency from the currency column below
  // — a sibling here would be redundant.
  unitAmount  BigInt       @map("unit_amount")
  totalAmount BigInt       @map("total_amount")
  isTaxable   Boolean      @default(true) @map("is_taxable")
  sortOrder   Int          @default(0) @map("sort_order")
  currency    String       @default("PHP")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz

  booking Booking @relation(fields: [bookingId], references: [id])

  @@map("booking_line_items")
}

model MaintenanceRecord {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vehicleId   String            @map("vehicle_id") @db.Uuid
  type        MaintenanceType
  status      MaintenanceStatus @default(SCHEDULED)
  scheduledAt DateTime          @map("scheduled_at") @db.Timestamptz
  completedAt DateTime?         @map("completed_at") @db.Timestamptz
  notes       String?
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@map("maintenance_records")
}

model VehicleBlock {
  id               String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vehicleId        String                 @map("vehicle_id") @db.Uuid
  blockType        BlockType              @map("block_type")
  period           Unsupported("tstzrange")
  endsAtLocationId String?                @map("ends_at_location_id") @db.Uuid
  // Nullable — a MAINTENANCE or MANUAL block belongs to neither a booking
  // nor a quote. Cascade: deleting the booking/quote it holds for must not
  // leave an orphan block holding a vehicle hostage.
  bookingId        String?                @map("booking_id") @db.Uuid
  quoteId          String?                @map("quote_id") @db.Uuid
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz

  // The exclusion constraint and GiST index are created via raw SQL in
  // prisma/migrations — Prisma cannot express EXCLUDE USING gist.

  vehicle        Vehicle   @relation(fields: [vehicleId], references: [id])
  endsAtLocation Location? @relation("EndsAtLocation", fields: [endsAtLocationId], references: [id])
  booking        Booking?  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  quote          Quote?    @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("vehicle_blocks")
}

model Notification {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type              NotificationType
  channel           NotificationChannel
  recipient         String
  bookingId         String?             @map("booking_id") @db.Uuid
  templateKey       String              @map("template_key")
  // Render variables only (names, dates, amounts as pre-formatted strings,
  // reference, location details) — NEVER licence numbers, passwords,
  // tokens, keys, or signed URLs. See lib/notifications/templates.
  payload           Json
  status            NotificationStatus  @default(QUEUED)
  attempts          Int                 @default(0)
  providerMessageId String?             @map("provider_message_id")
  error             String?
  sentAt            DateTime?           @map("sent_at") @db.Timestamptz
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("notifications")
}
